generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id               Int           @id @default(autoincrement())
  name             String
  externalSiteId   String        @unique
  isActive         Boolean       @default(true)
  normalizedStatus String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  apiLogs          ApiLog[]
  devices          Device[]
  events           DeviceEvent[]
}

model Device {
  id                 Int           @id @default(autoincrement())
  siteId             Int
  externalDeviceId   String
  name               String?
  modelType          String?
  ipAddress          String?
  rawStatus          String?
  normalizedStatus   String?
  lastSeenAt         DateTime?
  lastStatusChangeAt DateTime?
  vendor             String?       @default("unifi")
  isPrimaryHost      Boolean       @default(false)
  wan1Status         String?
  wan2Status         String?
  wan1LastChange     DateTime?
  wan2LastChange     DateTime?
  apiLogs            ApiLog[]
  site               Site          @relation(fields: [siteId], references: [id])
  events             DeviceEvent[]
}

model DeviceEvent {
  id         Int      @id @default(autoincrement())
  deviceId   Int
  siteId     Int
  eventType  String
  severity   String
  title      String
  message    String?
  rawPayload String?
  createdAt  DateTime @default(now())
  device     Device   @relation(fields: [deviceId], references: [id])
  site       Site     @relation(fields: [siteId], references: [id])
}

model ApiLog {
  id               Int      @id @default(autoincrement())
  siteId           Int?
  deviceId         Int?
  context          String
  rawStatusFromApi String?
  calculatedStatus String?
  reason           String?
  createdAt        DateTime @default(now())
  device           Device?  @relation(fields: [deviceId], references: [id])
  site             Site?    @relation(fields: [siteId], references: [id])
}

model SiteStatusSnapshot {
  id             Int       @id @default(autoincrement())
  key            String    @unique
  siteId         String?
  hostId         String?
  siteName       String
  overallStatus  String
  totalDevices   Int
  offlineDevices Int
  lastChangeAt   DateTime?
  createdAt      DateTime  @default(now())
}

model Event {
  id            Int      @id @default(autoincrement())
  siteKey       String?
  siteId        String?
  hostId        String?
  siteName      String
  deviceName    String?
  severity      String
  type          String
  title         String
  message       String?
  isPrimaryHost Boolean  @default(false)
  createdAt     DateTime @default(now())
}
